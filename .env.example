# Runtime
APP_ENV=production
APP_SECRET_KEY=replace-with-a-random-value-of-at-least-32-characters
DATABASE_URL=postgresql+asyncpg://mail_control:replace-db-password@postgres:5432/mail_control
SYSTEM_DATABASE_URL=
# Solo para Alembic: rol propietario del esquema; no usar para tráfico normal.
MIGRATION_DATABASE_URL=postgresql+asyncpg://mail_control:replace-db-password@postgres:5432/mail_control
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://mail_control:replace-rabbitmq-password@rabbitmq:5672/
ALLOWED_ORIGINS=https://panel.ecormecejhelizstore.com
FRONTEND_URL=https://panel.ecormecejhelizstore.com
LOG_LEVEL=INFO

# Session security
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
CREDENTIAL_ENCRYPTION_KEY_FILE=/run/secrets/credential-encryption-key

# Google OAuth and Gmail push
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://panel.ecormecejhelizstore.com/v1/providers/gmail/callback
GOOGLE_LOGIN_REDIRECT_URI=https://panel.ecormecejhelizstore.com/v1/auth/oauth/google/callback
GMAIL_PUSH_ENABLED=false
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT=
GMAIL_PUBSUB_VERIFICATION_TOKEN=
GMAIL_WATCH_LABEL_IDS=INBOX

# Microsoft OAuth and Graph
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://panel.ecormecejhelizstore.com/v1/providers/microsoft/callback
MICROSOFT_LOGIN_REDIRECT_URI=https://panel.ecormecejhelizstore.com/v1/auth/oauth/microsoft/callback
MICROSOFT_GRAPH_WEBHOOK_ENABLED=false
MICROSOFT_GRAPH_NOTIFICATION_URL=
MICROSOFT_GRAPH_LIFECYCLE_URL=

# Corporate outbound mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=corp@jhelizstore.xyz
SMTP_PASSWORD=
SMTP_FROM=corp@jhelizstore.xyz

# AI analysis
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Operational Telegram alerts are loaded from a mounted secret file.
TELEGRAM_ALERTS_FILE=/run/secrets/telegram-alerts.env
TELEGRAM_ACCOUNT_ALERT_DEDUPE_SECONDS=3600
