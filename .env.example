# === Mail Control (copiar a .env y completar) ===

# Postgres
POSTGRES_USER=mailctl
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=mailctl
DATABASE_URL=postgresql+psycopg2://mailctl:cambia-esta-clave@db:5432/mailctl

# Redis
REDIS_URL=redis://redis:6379/0

# Seguridad
# Generar: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generar: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
ALLOWED_ORIGINS=https://panel.ecormecejhelizstore.com
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_SECONDS=900
SESSION_COOKIE_NAME=__Host-mailctl_session
SESSION_COOKIE_SECURE=true
ALLOWED_HOSTS=panel.ecormecejhelizstore.com,localhost,127.0.0.1,backend
HTTP_MAX_BODY_BYTES=1048576
HTTP_RATE_LIMIT=240
HTTP_WRITE_RATE_LIMIT=90
HTTP_LOGIN_RATE_LIMIT=20
HTTP_AGENT_RATE_LIMIT=300

# Microsoft Entra ID OAuth2
# URI exacta que debes registrar como plataforma "Web" en Entra ID.
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=ejemplo-client-secret-cambiar
MICROSOFT_REDIRECT_URI=https://panel.ecormecejhelizstore.com/api/microsoft/callback
FRONTEND_URL=https://panel.ecormecejhelizstore.com

# Backups cifrados por MEGA (usar cuenta dedicada; contraseña opcional
# después de persistir una sesión interactiva en el volumen mega_session)
MEGA_EMAIL=backups@example.com
MEGA_PASSWORD=ejemplo-mega-cambiar
MEGA_FOLDER=/MailControlBackups
BACKUP_DAILY_KEEP_DAYS=30
BACKUP_MONTHLY_KEEP_MONTHS=12
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=
BACKUP_NOTIFY_SUCCESS=true
BACKUP_ARCHIVE_PASSWORD=ejemplo-frase-larga-unica-cambiar

# Admin inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@ecormecejhelizstore.com
ADMIN_PASSWORD=

# Límites (VPS 1 vCPU / 2 GB)
IMAP_MAX_CONCURRENCY=50
IMAP_CHUNK_SIZE=10
IMAP_FETCH_LIMIT=30
SCAN_INTERVAL_MINUTES=10
# Token exclusivo para que el agente local solicite códigos recientes.
MAIL_AGENT_API_TOKEN=replace-with-a-random-64-character-token
MAIL_AGENT_CODE_MAX_AGE_SECONDS=600

# Bot privado de administración de Mail Control.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=8761148983
TELEGRAM_NOTIFY_ALERTS=true
TELEGRAM_NOTIFY_ACCOUNT_ERRORS=true
TELEGRAM_DAILY_SUMMARY=true
