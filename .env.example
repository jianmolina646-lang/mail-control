# === Mail Control (copiar a .env y completar) ===

# Postgres
POSTGRES_USER=mailctl
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=mailctl
DATABASE_URL=postgresql+psycopg2://mailctl:cambia-esta-clave@db:5432/mailctl

# Redis
REDIS_URL=redis://redis:6379/0

# Seguridad
# Generar: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generar: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Microsoft Entra ID OAuth2
# URI exacta que debes registrar como plataforma "Web" en Entra ID.
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=ejemplo-client-secret-cambiar
MICROSOFT_REDIRECT_URI=https://panel.ecormecejhelizstore.com/api/microsoft/callback
FRONTEND_URL=https://panel.ecormecejhelizstore.com

# Admin inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@ecormecejhelizstore.com
ADMIN_PASSWORD=

# Límites (VPS 1 vCPU / 2 GB)
IMAP_MAX_CONCURRENCY=50
IMAP_CHUNK_SIZE=10
IMAP_FETCH_LIMIT=30
SCAN_INTERVAL_MINUTES=10
